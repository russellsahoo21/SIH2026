    {
      "name": "11. Matching - Suggest Category and Institution",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{officerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institutionName\": \"Hillcrest Inst. of Tech.\",\n  \"description\": \"Demanding high capitation fees from first year students\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/suggest",
          "host": ["{{baseUrl}}"],
          "path": ["api", "suggest"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.data.category.suggested).to.eql('FEES');",
              "pm.expect(json.data.institutionCandidates.length).to.be.above(0);"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Cases - Register Case",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{officerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institutionId\": {{testInstId}},\n  \"category\": \"FEES\",\n  \"sourceChannel\": \"CPGRAMS\",\n  \"receivedOn\": \"2026-10-25\",\n  \"description\": \"Excessive unauthorized fee collection for laboratory and tuition.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/cases",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.expect(json.data.case.status).to.eql('NEW');",
              "pm.expect(json.data.case.slaState).to.be.a('string');",
              "var encodedId = encodeURIComponent(json.data.case.id);",
              "pm.environment.set('createdCaseId', encodedId);",
              "pm.environment.set('caseVersion', json.data.case.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Cases - Get Case Detail (Full Visibility)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/cases/{{createdCaseId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases", "{{createdCaseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.data.accessLevel).to.eql('FULL');",
              "pm.expect(json.data.description).to.not.be.null;"
            ]
          }
        }
      ]
    },
