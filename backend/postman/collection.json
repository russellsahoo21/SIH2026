{
  "info": {
    "name": "SIH 2026 AICTE Complaint System - Automated API Tests",
    "_postman_id": "c1f7a268-3d2b-4d42-8947-8a8f5b820a91",
    "description": "Comprehensive Postman test suite covering all Dev A & Dev B endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response envelope has status ok', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.data.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Bureaus List",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bureaus",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bureaus"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns list of active bureaus', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.data.length).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Categories Reference",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "categories"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Contains standard complaint categories', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.data).to.be.an('array');",
              "  var codes = json.data.map(c => c.code);",
              "  pm.expect(codes).to.include('FEES');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Auth - Login Officer (RB)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"officer.rb1\",\n  \"password\": \"Demo@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Token and user returned', function () {",
              "  pm.expect(json.data.token).to.be.a('string');",
              "  pm.expect(json.data.user.role).to.eql('OFFICER');",
              "  pm.expect(json.data.user.bureau).to.eql('RB');",
              "  pm.environment.set('officerToken', json.data.token);",
              "});"
            ]
          }
        }
      ]
    },
