    {
      "name": "12. Cases - Register Case",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{officerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"institutionId\": {{testInstId}},\n  \"category\": \"FEES\",\n  \"sourceChannel\": \"CPGRAMS\",\n  \"receivedOn\": \"2026-10-25\",\n  \"description\": \"Unauthorized development fees requested for first-year engineering intake.\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/cases", "host": ["{{baseUrl}}"], "path": ["api", "cases"] }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
            "var json = pm.response.json();",
            "pm.expect(json.data.case.status).to.eql('NEW');",
            "pm.environment.set('createdCaseId', encodeURIComponent(json.data.case.id));",
            "pm.environment.set('caseVersion', json.data.case.version);"
          ]
        }
      }]
    },
