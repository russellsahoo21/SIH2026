    {
      "name": "08. Users - List Users (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/users?pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"],
          "query": [{ "key": "pageSize", "value": "10" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.data).to.be.an('array');",
              "pm.expect(json.meta.total).to.be.above(0);",
              "json.data.forEach(function(u) { pm.expect(u).to.not.have.property('password_hash'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Institutions - Search & Normalize",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/institutions?q=hillcrest inst tech",
          "host": ["{{baseUrl}}"],
          "path": ["api", "institutions"],
          "query": [{ "key": "q", "value": "hillcrest inst tech" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.expect(json.data).to.be.an('array');",
              "pm.expect(json.data.length).to.be.at.least(1);",
              "pm.environment.set('testInstId', json.data[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Institutions - Profile by ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
